# variabile pentru docker-compose.prod.yml (stack de producție, pe VPS).
# copiază în .env (necomis, e în .gitignore) și completează valorile reale.
# NU e același .env cu server/.env (acela e pentru dev local, rulat cu npm run dev).

# numele de domeniu public, ex: fleetpilot.exemplu.ro — Caddy obține automat HTTPS
# (Let's Encrypt) pentru el. Pentru testare locală fără domeniu real: DOMAIN=:80
DOMAIN=fleetpilot.exemplu.ro

# originea publică completă (cu schemă) — folosită de server pt. CORS și Socket.io.
# cu un domeniu real: https://<DOMAIN de mai sus>. Local fără TLS: http://localhost
PUBLIC_URL=https://fleetpilot.exemplu.ro

POSTGRES_PASSWORD="schimba-ma"
JWT_SECRET="schimba-ma-cu-un-secret-de-minim-32-caractere"

# cheie din console.anthropic.com, necesită credit pe cont (Faza 4 — agentul AI)
ANTHROPIC_API_KEY="sk-ant-..."
