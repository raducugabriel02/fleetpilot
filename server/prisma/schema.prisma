generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DISPATCHER
  DRIVER
}

enum VehicleType {
  VAN // dubă, până în 3.5t
  TRUCK // camion rigid
  SEMI // cap tractor + semiremorcă (TIR)
}

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  IN_SERVICE
}

enum TripStatus {
  REQUEST
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AbsenceType {
  VACATION
  SICK_LEAVE
  OTHER
}

enum AgentDecision {
  PENDING
  APPROVED
  MODIFIED
  REJECTED
}

model Company {
  id           String        @id @default(cuid())
  name         String
  cui          String?       @unique
  createdAt    DateTime      @default(now())
  users        User[]
  vehicles     Vehicle[]
  drivers      Driver[]
  clients      Client[]
  trips        Trip[]
  agentActions AgentAction[]
}

model User {
  id            String         @id @default(cuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email         String         @unique
  passwordHash  String
  name          String
  role          Role
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  driver        Driver?
  refreshTokens RefreshToken[]
  createdTrips  Trip[]         @relation("TripCreatedBy")
  agentActions  AgentAction[]

  @@index([companyId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
}

model Vehicle {
  id                String            @id @default(cuid())
  companyId         String
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plateNumber       String
  type              VehicleType
  capacityTons      Decimal           @db.Decimal(6, 2)
  capacityPallets   Int
  status            VehicleStatus     @default(AVAILABLE)
  itpExpiresAt      DateTime?
  rcaExpiresAt      DateTime?
  vignetteExpiresAt DateTime?
  trips             Trip[]
  positions         VehiclePosition[]

  @@unique([companyId, plateNumber])
  @@index([companyId, status])
}

model Driver {
  id                String          @id @default(cuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId            String          @unique
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone             String?
  licenseCategories String[] // ex: ["B", "C", "CE"]
  licenseExpiresAt  DateTime?
  absences          DriverAbsence[]
  trips             Trip[]

  @@index([companyId])
}

model DriverAbsence {
  id       String      @id @default(cuid())
  driverId String
  driver   Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  type     AbsenceType
  startsAt DateTime    @db.Date
  endsAt   DateTime    @db.Date
  note     String?

  @@index([driverId, startsAt, endsAt])
}

model Client {
  id          String  @id @default(cuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  trips       Trip[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Trip {
  id               String            @id @default(cuid())
  companyId        String
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId         String
  client           Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  vehicleId        String?
  vehicle          Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId         String?
  driver           Driver?           @relation(fields: [driverId], references: [id], onDelete: SetNull)
  createdById      String
  createdBy        User              @relation("TripCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  originAddress    String
  originLat        Float?
  originLng        Float?
  destAddress      String
  destLat          Float?
  destLng          Float?
  cargoDescription String
  pallets          Int?
  weightTons       Decimal?          @db.Decimal(6, 2)
  windowStart      DateTime
  windowEnd        DateTime
  status           TripStatus        @default(REQUEST)
  distanceKm       Float?
  durationMin      Int?
  routeGeometry    Json? // polyline OSRM — o folosește simulatorul GPS
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  positions        VehiclePosition[]
  agentActions     AgentAction[]

  @@index([companyId, status])
  @@index([companyId, windowStart])
  @@index([vehicleId, windowStart])
  @@index([driverId, windowStart])
}

model VehiclePosition {
  id         BigInt   @id @default(autoincrement())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tripId     String?
  trip       Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  lat        Float
  lng        Float
  speedKmh   Float
  heading    Float?
  recordedAt DateTime @default(now())

  @@index([vehicleId, recordedAt])
  @@index([tripId, recordedAt])
}

model AgentAction {
  id           String        @id @default(cuid())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  tripId       String?
  trip         Trip?         @relation(fields: [tripId], references: [id], onDelete: SetNull)
  requestText  String // cererea în limbaj natural, exact cum a venit
  toolCalls    Json? // tool-urile rulate de agent + rezumatul rezultatelor
  proposal     Json // propunerea structurată prezentată dispecerului
  decision     AgentDecision @default(PENDING)
  decisionNote String?
  decidedAt    DateTime?
  createdAt    DateTime      @default(now())

  @@index([companyId, createdAt])
}
